display "=== 1. Testing Xml Package & Sub-Libraries ===" ?color=#38bdf8
load Xml as xml
from Xml import Query

set doc: xml.parse("<root><user>Architect</user><role>Admin</role></root>")
set users: xml.find(doc, "user")
set u0: users[0]
set userName: Query.extractText(u0)
display "Xml Parsed User: " + userName ?color=#22c55e
Assert.equal(userName, "Architect", "Xml must extract user text correctly")

display "=== 2. Testing Sql Package & Sub-Libraries ===" ?color=#38bdf8
load Sql as sql
from Sql import Table
import Sql.Query as sq

set q: sq.select(["id", "name", "role"])
set q2: sq.from(q, "users")
set q3: sq.where(q2, "role = 'Admin'")
set finalSql: sq.build(q3)
display "Built SQL: " + finalSql ?color=#22c55e
Assert.equal(finalSql, "SELECT id, name, role FROM users WHERE role = 'Admin'", "Sql query builder must construct valid SQL")

set tbl: Table.create("audit_log", ["timestamp", "action"])
Table.insert(tbl, ["2026-10-18", "LOGIN"])
Table.insert(tbl, ["2026-10-18", "UPDATE"])
display "Table Row Count: " + Table.count(tbl) ?color=#22c55e
Assert.equal(Table.count(tbl), 2, "Table count must be 2")

display "=== 3. Testing TerminalUI Package & Sub-Libraries ===" ?color=#38bdf8
load TerminalUI as tui
import TerminalUI.Box as box
import TerminalUI.Bar as bar

set b1: box.single("DEPLOYMENT COMPLETE", "STATUS")
display b1 ?color=#22c55e

set pBar: bar.progress(75, 20)
display "Progress Bar: " + pBar ?color=#22c55e
Assert.equal(pBar, "[===============     ] 75%", "Progress bar formatting must match")

display "=== 4. Testing Archive Package & Sub-Libraries ===" ?color=#38bdf8
load Archive as arc
from Archive import Semver
from Archive import Zip

set isNewer: Semver.isGreater("2.1.0", "1.9.5")
display "Semver 2.1.0 > 1.9.5: " + isNewer ?color=#22c55e
Assert.equal(isNewer, true, "Semver comparison must be true")

set z: Zip.create()
Zip.add(z, "main.vrs", "display 'Hello'")
set content: Zip.get(z, "main.vrs")
display "Zip entry content: " + content ?color=#22c55e
Assert.equal(content, "display 'Hello'", "Zip file get must return content")

display "=== 5. Testing Tensor Package & Sub-Libraries ===" ?color=#38bdf8
load Tensor as tensor
import Tensor.Ops as tops
from Tensor import Activation

set dotProduct: tops.dot([1, 2, 3], [4, 5, 6])
display "Tensor Dot Product: " + dotProduct ?color=#22c55e
Assert.equal(dotProduct, 32, "Dot product of [1,2,3] and [4,5,6] must be 32")

set activated: Activation.relu(15)
set deactivated: Activation.relu(-10)
display "ReLU(15): " + activated + " | ReLU(-10): " + deactivated ?color=#22c55e
Assert.equal(activated, 15, "ReLU(15) must be 15")
Assert.equal(deactivated, 0, "ReLU(-10) must be 0")

display "ALL COMMUNITY PACKAGES & SUB-LIBRARIES PASSED CLEANLY!" ?color=#50fa7b
