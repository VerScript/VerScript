{
  "comments": {
    "lineComment": "!",
    "blockComment": [
      "!!",
      "!!"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|class|lib|header|config:|enum|struct|DataType|alias|static:|dynamic:|meta:|thisstatic:|do|unless|if|match|with|case|loop|repeat|while|until|cycle|for).*$",
    "decreaseIndentPattern": "^\\s*(unless|else|with|case|_:).*$"
  }
}