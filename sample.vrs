!!
  VerScript Comprehensive Showcase — v2.0
  Showcasing:
    1: Custom Functions (def func ... reply) & Purity Contracts (inbound/outbound)
    2: Methods (def method) with State Mutation & Early Return (reply)
    3: Explicit Variable Assignment with "set" keyword
    4: ANSI & TrueColor Hex Attributes (?color=#38bdf8, ?newline=false)
    5: Command Aliasing & Polyglot Injections
    6: Robust Error Handling (do ... unless) & ScopeViolationError
!!

display "=== 1. Explicit Variable Setting ===" ?color=#38bdf8
set status: "Engine Operational"
set base_power: 50
set boost_multiplier: 3
display "System Status: " + status ?color=#22c55e

display "=== 2. Pure Custom Functions (Inbound by default) ===" ?color=#c084fc
def func calculate_power base mult
  reply base * mult

set total_power: (calculate_power base_power boost_multiplier)
display "Calculated Total Power: " + total_power ?color=#38bdf8

display "=== 3. Scope Isolation & Purity Enforcement ===" ?color=#fbbf24
def func pure_routine delta
  ! Modifying outer variables from an inbound function raises ScopeViolationError
  set base_power: base_power + delta
  reply base_power

do
  res: (pure_routine 100)
unless ScopeViolationError
  display "Purity Guard Active: Caught ScopeViolationError successfully!" ?color=#22c55e

display "=== 4. Custom Methods (Stateful & Void) ===" ?color=#c084fc
set system_cycles: 0

def method run_diagnostics iterations
  iterate step from 1 to iterations step 1
    if step = 3 then
      set system_cycles: system_cycles + step
      reply ! Early exit
    set system_cycles: system_cycles + step

run_diagnostics 5
display "System Cycles after method call: " + system_cycles ?color=#38bdf8

display "=== 5. Command Aliasing & Hex Colors ===" ?color=#38bdf8
alias display: log
log "Logging via custom alias with Hex Color #38bdf8!" ?color=#38bdf8

display "=== 6. Polyglot Code Injection ===" ?color=#fbbf24
inject python ?color=yellow
  def py_helper(val):
      return f"Python processing {val}"
  print("Polyglot layer executed cleanly")

inject verscript
  display "Dynamic nested VerScript runtime active!" ?color=#22c55e

display "=== VerScript v2.0 System Ready ===" ?color=#22c55e
